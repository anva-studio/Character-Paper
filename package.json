{
  "name": "character-paper",
  "productName": "Character Paper",
  "version": "1.0.2",
  "description": "A place for every character. A free local writing app by ANVA.",
  "author": "ANVA",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.0",
    "scrypt-js": "3.0.1",
    "yauzl": "3.2.0",
    "yazl": "3.3.1"
  },
  "build": {
    "appId": "studio.anva.characterpaper",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "../../outputs/Character-Paper-Windows-build",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "package.json",
      "app/*.js",
      "app/*.cjs",
      "app/*.css",
      "app/index.html",
      "app/logo.svg",
      "app/welcome-art.png",
      "build/icon.png",
      "app/*.txt"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Character-Paper-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Character Paper",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "publish": null
  }
}
